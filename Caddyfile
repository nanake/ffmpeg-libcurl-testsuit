{
    auto_https disable_redirects
}

http://test.local:8080 {
    root * /srv

    @redirect path /redirect
    redir @redirect /media/test.wav 302

    @auth path /private/*
    basic_auth @auth bcrypt {
                ffmpeg {$AUTH_HASH}
    }

    encode gzip
    file_server
}

https://test.local:8443 {
    tls internal
    root * /srv

    @redirect path /redirect
    redir @redirect /media/test.wav 302

    @auth path /private/*
    basic_auth @auth bcrypt {
                ffmpeg {$AUTH_HASH}
    }

    encode gzip
    file_server
}
